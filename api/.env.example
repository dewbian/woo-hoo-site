# woohoo-journal-api 환경변수 — 실제 값은 VPS 의 api/.env 에만 두고 절대 커밋 금지.

# PWA 폼 인증 토큰 (랜덤 길게. 예: openssl rand -hex 32). 폰 폼에 1회 저장해 사용.
JOURNAL_TOKEN=여기에_랜덤_토큰

# 봇이 커밋할 repo clone 의 루트 (api/ 의 상위)
REPO_DIR=/home/www/woo-hoo.kr/journal-api

# 공개 사이트 URL (응답 링크용)
SITE_URL=https://woo-hoo.kr

# 로컬 바인드 포트 (nginx proxy_pass 대상). spick:8000 / blog:8001 와 겹치지 않게.
PORT=8011
